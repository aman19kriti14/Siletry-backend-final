# Local run: export these, or set them in Railway → Variables
PGHOST=localhost
PGPORT=5432
PGDATABASE=siletry
PGUSER=postgres
PGPASSWORD=postgres
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
CREDENTIALS_KEY=replace-with-another-long-random-string
ALLOWED_ORIGINS=http://localhost:5173
DEV_TOOLS=true
SEED_DEMO=true
# Real WhatsApp (see META_SETUP.md)
META_GRAPH_VERSION=v22.0
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ADMIN_PHONE_NUMBER_ID=
META_ADMIN_ACCESS_TOKEN=
META_ADMIN_DISPLAY_NUMBER=
